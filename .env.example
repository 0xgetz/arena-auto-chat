# arena-auto-chat configuration
# Copy to .env and edit. Every value can also be passed as a CLI flag,
# which takes precedence over the environment.

# --- browser ---
# Path to Chrome/Chromium. Empty = auto-detect.
CHROME_PATH=
# Run headless (no visible window). Set to 0 to watch the automation.
HEADLESS=1
# Port for the DevTools endpoint of the Chromium we launch.
CDP_PORT=9222
# Optional browser-only proxy, e.g. socks5://127.0.0.1:10808 or http://10.0.0.1:8080
BROWSER_PROXY=
# Persistent profile directory. Empty = a throwaway temp profile per run.
PROFILE_DIR=
# Attach to an already-running browser instead of launching one.
# Accepts a WebSocket URL (ws://…/devtools/browser/…) or an HTTP DevTools base
# (http://127.0.0.1:9222), from which the WebSocket URL is discovered.
CDP_URL=

# --- timeouts (milliseconds) ---
# How long to wait for the arena.ai verification email to arrive.
EMAIL_TIMEOUT=180000
# How long to wait for a chat reply to finish.
REPLY_TIMEOUT=180000
# Per-step page/navigation timeout.
PAGE_TIMEOUT=60000

# --- zenvex temp mail ---
# Pin the receiving domain. Empty = pick one at random from the live list.
ZENVEX_DOMAIN=

# --- chat defaults ---
# The model slug used by `chat` / `run`.
ARENA_MODEL=deepseek-v4.1-flash-max
# Default prompt when none is given on the command line.
ARENA_PROMPT=test

# --- output ---
# Where account records are written.
OUT_DIR=outputs
